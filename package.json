{
  "name": "curviosclash",
  "version": "1.0.0",
  "private": true,
  "description": "Bereinigte, vollstaendige Produktbasis des klassischen CurviosClash-Spiels",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "git:hooks:install": "git config core.hooksPath .githooks",
    "build": "vite build && node scripts/check-production-training-boundary.mjs dist",
    "build:web": "vite build --mode web && node scripts/check-production-training-boundary.mjs dist",
    "build:app": "vite build --mode app && node scripts/check-production-training-boundary.mjs dist-app",
    "build:game": "vite build --mode game && node scripts/check-game-build.mjs dist-game",
    "build:app:test": "node scripts/build-playwright-app.mjs",
    "preview": "vite preview",
    "browser:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./server.ps1",
    "app:setup": "npm --prefix electron ci",
    "app:start": "npm run build:app && npm --prefix electron run start",
    "app:start:raw": "npm --prefix electron run start",
    "app:settings:start": "npm --prefix electron run start:settings",
    "app:package": "node scripts/package-game-app.mjs",
    "app:package:verify": "node scripts/check-packaged-electron.mjs",
    "game:export": "node scripts/export-game-repo.mjs",
    "game:export:check": "node scripts/check-game-export.mjs",
    "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-installer.ps1",
    "release:verify": "node scripts/release-verify.mjs",
    "server:start": "npm --prefix server start",
    "server:lan": "npm --prefix server run start:lan",
    "app:android:build": "node scripts/build-mobile-classic-app.mjs",
    "app:android:check": "node --test tests/mobile-classic-app.contract.test.mjs tests/mobile-arcade-app.contract.test.mjs",
    "app:android:add": "node scripts/capacitor-mobile-classic.mjs add",
    "app:android:sync": "node scripts/capacitor-mobile-classic.mjs sync",
    "app:android:copy": "node scripts/capacitor-mobile-classic.mjs copy",
    "app:android:assets:check": "node scripts/capacitor-mobile-classic.mjs check-assets",
    "app:android:open": "node scripts/capacitor-mobile-classic.mjs open",
    "app:android:apk": "node scripts/capacitor-mobile-classic.mjs apk",
    "app:android:install": "node scripts/capacitor-mobile-classic.mjs install",
    "app:android:update:github": "node scripts/update-mobile-classic-from-github.mjs",
    "android:update:phone": "node scripts/update-android-phone.mjs",
    "assets:cc0:download": "node scripts/download_cc0_models.js",
    "maps:generate": "node scripts/generate-map-assets.mjs",
    "lint": "eslint src electron server editor scripts prototypes/vehicle-lab dev/vite --max-warnings 0",
    "typecheck:architecture": "tsc -p tsconfig.architecture.json && node scripts/check-product-typecheck-ratchet.mjs",
    "typecheck:contracts": "tsc -p tsconfig.contracts.json",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs && node scripts/check-architecture-ratchet.mjs && node scripts/check-runtime-determinism.mjs && node scripts/check-runtime-encoding.mjs && node scripts/check-editor-path-drift.mjs",
    "check:parcours": "node scripts/check-parcours-routes.mjs",
    "test": "npm run test:contract",
    "test:contract:fast": "node scripts/run-contract-tests.mjs fast",
    "test:contract:coverage": "node scripts/run-contract-tests.mjs fast --coverage",
    "pretest:contract:dist": "npm run build:app",
    "test:contract:dist": "node scripts/run-contract-tests.mjs dist",
    "test:contract": "npm run test:contract:fast && npm run test:contract:dist",
    "test:dev:training": "node --test \"dev/training/tests/*.test.mjs\" \"dev/training/tests/*.contract.test.mjs\"",
    "test:hygiene": "node scripts/test-hygiene.mjs",
    "test:desktop:smoke": "npm run build:app:test && node scripts/run-playwright-smoke.mjs tests/core.spec.js --timeout=180000",
    "test:desktop:e2e": "npm run build:app:test && node scripts/run-playwright-targeted-clusters.mjs",
    "test:browser:compat": "node scripts/run-playwright-browser-contract.mjs tests/core-targeted.spec.js --grep \"T1:|T2:|T3:\"",
    "test:editor-ui": "npm run build:app:test && node scripts/run-playwright-targeted.mjs tests/editor-map-ui.spec.js",
    "test:gpu": "npm run build:app:test && node scripts/run-playwright-targeted.mjs tests/gpu.spec.js",
    "test:physics": "npm run build:app:test && node scripts/run-playwright-targeted.mjs tests/physics-core.spec.js tests/physics-hunt.spec.js tests/physics-policy.spec.js",
    "test:stress": "npm run build:app:test && node scripts/run-playwright-targeted.mjs tests/stress.spec.js",
    "test:heavy": "npm run build:app:test && node scripts/run-playwright-targeted.mjs tests/gpu.spec.js tests/stress.spec.js tests/v28-regression.spec.js --timeout=240000",
    "test:smoke": "npm run test:desktop:smoke",
    "test:core": "npm run test:contract && npm run test:desktop:smoke",
    "smoke:selftrail": "npm run build && node scripts/self-trail-debug-smoke.mjs",
    "smoke:roundstate": "node scripts/round-state-controller-smoke.mjs",
    "smoke:arcade": "node scripts/arcade-run-smoke.mjs",
    "smoke:headless-kernel": "node dev/training/scripts/headless-match-kernel-smoke.mjs",
    "bot:validate": "node dev/training/scripts/bot-validation-runner.mjs",
    "bot:validate:fight": "node dev/training/scripts/bot-play-analysis.mjs --scenario-ids H-FIGHT-DUEL --policy heuristic --rounds 8 --headless true --fail-on-forced-round true",
    "bot:validate:flight": "node dev/training/scripts/bot-play-analysis.mjs --scenario-ids H-FIGHT-DUEL,H-CLASSIC-3D-HARD,H-ARCADE-VERTICAL --policy heuristic --rounds 2 --headless true",
    "bot:validate:team": "node dev/training/scripts/bot-validation-runner.mjs --scenario-ids H-TEAM-FLAGS,H-TEAM-ESCORT --policy heuristic --rounds 1 --headless true --force-timeout 12000 --match-timeout 25000 --total-timeout 180000",
    "bot:analyze": "node dev/training/scripts/bot-play-analysis.mjs",
    "bot:improve": "node dev/training/scripts/heuristic-improvement-loop.mjs",
    "bot:improve:auto": "node dev/training/scripts/heuristic-improvement-runner.mjs",
    "bot:improve:team": "node dev/training/scripts/team-objective-improvement-loop.mjs",
    "bot:improve:team:auto": "node dev/training/scripts/team-objective-improvement-runner.mjs",
    "bot:improve:team:status": "node dev/training/scripts/team-objective-improvement-loop.mjs --status",
    "bot:improve:team:verify": "node dev/training/scripts/team-objective-improvement-loop.mjs --verify",
    "bot:improve:team:audit": "node dev/training/scripts/team-objective-improvement-loop.mjs --audit",
    "benchmark:baseline": "node dev/training/scripts/bot-benchmark-baseline.mjs",
    "benchmark:lifecycle": "node scripts/perf-lifecycle-measure.mjs",
    "benchmark:jitter": "node scripts/perf-jitter-matrix.mjs",
    "council:check": "node scripts/check-council-config.mjs",
    "council:test": "node --test tests/council-runner.contract.test.mjs tests/council-hardening-runner.contract.test.mjs tests/council-benchmark.contract.test.mjs tests/council-test-loop/fixture-behavior.test.mjs",
    "council:agent": "node scripts/council-hardening-runner.mjs agent",
    "council:live-smoke": "node scripts/council-live-smoke.mjs",
    "council:validate": "npm run council:check && npm run council:test && npm run council:live-smoke",
    "council:benchmark:dry-run": "node scripts/council-benchmark-runner.mjs dry-run",
    "council:benchmark:smoke": "node scripts/council-benchmark-runner.mjs smoke",
    "council:hardening": "node scripts/council-hardening-runner.mjs",
    "council:preflight": "node scripts/council-preflight.mjs",
    "council:baseline": "node scripts/council-baseline.mjs",
    "council:perf:snapshot": "node scripts/council-perf-run.mjs",
    "council:runner:init": "node scripts/council-runner.mjs init",
    "council:runner:implementation-plan": "node scripts/council-runner.mjs implementation-plan",
    "council:runner:scope-start": "node scripts/council-runner.mjs scope-start",
    "council:runner:scope-record": "node scripts/council-runner.mjs scope-record",
    "council:runner:review-plan": "node scripts/council-runner.mjs review-plan",
    "council:runner:gates": "node scripts/council-runner.mjs gates",
    "council:runner:next": "node scripts/council-runner.mjs next",
    "council:runner:record": "node scripts/council-runner.mjs record",
    "council:runner:report": "node scripts/council-runner.mjs report",
    "council:runner:reset": "node scripts/council-runner.mjs reset",
    "quality": "node scripts/run-quality.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "mp4-muxer": "^5.2.2",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.9.7",
    "eslint": "^10.10.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "ws": "^8.21.3"
  }
}
