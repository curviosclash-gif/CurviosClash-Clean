{
  "name": "curviosclash-app",
  "version": "1.0.0",
  "type": "module",
  "main": "main.cjs",
  "description": "CurviosClash Desktop App - Host multiplayer games",
  "scripts": {
    "start": "node launch.cjs",
    "start:settings": "node settings-studio/launch.cjs",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.curviosclash.app",
    "productName": "CurviosClash",
    "files": [
      "main.cjs",
      "launch.cjs",
      "preload.cjs",
      "ipc-sender-guard.cjs",
      "session-data-runtime.cjs",
      "tuning-window.cjs",
      "tuning-ipc.cjs",
      "tuning-preload.cjs",
      "tuning-console/**/*",
      "settings-studio/**/*",
      "recording-video-export-job.cjs",
      "static-server.cjs",
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist-app",
        "to": "dist-app"
      },
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "lan-signaling.js",
          "package.json"
        ]
      },
      {
        "from": "../src",
        "to": "src"
      },
      {
        "from": "runtime-resources/package.json",
        "to": "package.json"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "directories": {
      "output": "../release"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
