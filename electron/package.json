{
  "name": "curviosclash-app",
  "version": "1.0.0",
  "author": "CurviosClash Project",
  "type": "module",
  "main": "entry.cjs",
  "description": "CurviosClash Desktop App - Host multiplayer games",
  "scripts": {
    "start": "node launch.cjs",
    "start:settings": "node settings-studio/launch.cjs",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.curviosclash.app",
    "productName": "CurviosClash",
    "files": [
      "entry.cjs",
      "main.cjs",
      "launch.cjs",
      "preload.cjs",
      "ipc-sender-guard.cjs",
      "window-security-options.cjs",
      "session-data-runtime.cjs",
      "tuning-window.cjs",
      "tuning-ipc.cjs",
      "tuning-preload.cjs",
      "hangar-window.cjs",
      "hangar-preload.cjs",
      "editor-download-target.cjs",
      "main-window-lifecycle.cjs",
      "focus-scoped-shortcut.cjs",
      "editor-preload.cjs",
      "editor-vehicle-store.cjs",
      "tuning-console/**/*",
      "settings-studio/**/*",
      "recording-video-export-job.cjs",
      "cinematic-replay-video-export-job.cjs",
      "static-server.cjs",
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist-app",
        "to": "dist-app"
      },
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "lan-signaling.js",
          "package.json"
        ]
      },
      {
        "from": "../src",
        "to": "src",
        "filter": [
          "composition/core-ui/CoreSettingsPorts.js",
          "core/Config.js",
          "core/config/**/*.js",
          "core/runtime/ActiveRuntimeConfigStore.js",
          "core/settings/SettingsOverrideContract.js",
          "core/settings/SettingsOverrideMergeOps.js",
          "core/settings/SettingsOverrideRangeContract.js",
          "dev/tuning/*.js",
          "entities/GeneratedLocalMaps.js",
          "entities/PickupRegistry.js",
          "hunt/HuntConfig.js",
          "hunt/HuntMode.js",
          "platform/PlatformCapabilityAdapterSupport.js",
          "platform/electron/ElectronPlatformBridge.js",
          "shared/contracts/*.js",
          "shared/logging/Logger.js",
          "shared/runtime/BrowserStoragePorts.js",
          "shared/settings/*.js",
          "shared/storage/*.js",
          "shared/utils/CanonicalJson.js",
          "shared/utils/JsonClone.js",
          "state/storage/*.js",
          "ui/menu/*.js",
          "ui/SettingsFieldRegistry.js",
          "utils/MathOps.js"
        ]
      },
      {
        "from": "runtime-resources/package.json",
        "to": "package.json"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "directories": {
      "output": "../release"
    },
    "win": {
      "target": "nsis",
      "icon": "../assets/branding/curviosclash-icon.ico",
      "signAndEditExecutable": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  }
}
