{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/blender-object-batches/object-contract.schema.json",
  "title": "Blender Object Batch Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_revision",
    "object_id",
    "lifecycle",
    "count",
    "seed",
    "sampling",
    "naming_pattern",
    "invariants",
    "parameters",
    "build_profile",
    "outputs",
    "budgets",
    "qa",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "contract_revision": {"type": "integer", "minimum": 1},
    "object_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "enum": [
            "DRAFT",
            "CONTRACT_LOCKED",
            "PROTOTYPE_APPROVED",
            "GENERATED",
            "VALIDATED",
            "RELEASED",
            "REVISION_REQUIRED"
          ]
        },
        "prototype_id": {"type": "string"}
      }
    },
    "count": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 10},
    "seed": {"type": "integer", "default": 0},
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "canonical_first"],
      "properties": {
        "mode": {"enum": ["appendable", "coverage"], "default": "appendable"},
        "canonical_first": {"type": "boolean", "default": true}
      }
    },
    "naming_pattern": {"type": "string", "minLength": 1},
    "invariants": {"type": "object"},
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/parameter"}
    },
    "design_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "name"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "overrides": {"type": "object"}
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {"$ref": "#/$defs/constraint"}
    },
    "build_profile": {"type": "object"},
    "outputs": {
      "type": "object",
      "properties": {
        "required_roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "budgets": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-zA-Z0-9_]+_(min|max)$"},
      "additionalProperties": {"type": "number"}
    },
    "qa": {
      "type": "object",
      "properties": {
        "required_metrics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_views": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "roundtrip_import": {"type": "boolean"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["generator_id", "generator_version"],
      "properties": {
        "generator_id": {"type": "string", "minLength": 1},
        "generator_version": {"type": "string", "minLength": 1},
        "blender_version": {"type": "string"},
        "domain_skill": {"type": "string"}
      }
    }
  },
  "$defs": {
    "parameter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "min", "max"],
          "properties": {
            "type": {"const": "float"},
            "min": {"type": "number"},
            "max": {"type": "number"},
            "precision": {"type": "integer", "minimum": 0, "maximum": 12},
            "canonical": {"type": "number"},
            "strata_group": {"type": "string", "minLength": 1},
            "invert": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "min", "max"],
          "properties": {
            "type": {"const": "int"},
            "min": {"type": "integer"},
            "max": {"type": "integer"},
            "precision": {"type": "integer", "minimum": 0, "maximum": 12},
            "canonical": {"type": "integer"},
            "strata_group": {"type": "string", "minLength": 1},
            "invert": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "values"],
          "properties": {
            "type": {"const": "choice"},
            "values": {"type": "array", "minItems": 1, "uniqueItems": true},
            "canonical": {},
            "strata_group": {"type": "string", "minLength": 1},
            "invert": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"const": "bool"},
            "canonical": {"type": "boolean"},
            "strata_group": {"type": "string", "minLength": 1},
            "invert": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {"const": "fixed"},
            "value": {},
            "canonical": {}
          }
        }
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "then"],
      "properties": {
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parameter"],
          "properties": {
            "parameter": {"type": "string"},
            "equals": {},
            "in": {"type": "array", "minItems": 1}
          },
          "oneOf": [
            {"required": ["equals"], "not": {"required": ["in"]}},
            {"required": ["in"], "not": {"required": ["equals"]}}
          ]
        },
        "then": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "set": {"type": "object"},
            "disable": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "clamp": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "min": {"type": "number"},
                  "max": {"type": "number"}
                }
              }
            }
          }
        }
      }
    }
  }
}
